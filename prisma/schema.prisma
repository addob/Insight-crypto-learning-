// Prisma schema for Insight Crypto Learning
// Postgres everywhere — SQLite doesn't survive Vercel's ephemeral
// serverless filesystem, so both dev and prod point at a real Postgres
// instance via POSTGRES_URL. Deliberately POSTGRES_URL, not DATABASE_URL:
// Vercel's "Prisma Postgres" storage integration sets DATABASE_URL (and
// PRISMA_DATABASE_URL) to a prisma+postgres:// Accelerate connection
// string, which only works with the @prisma/extension-accelerate client
// extension — not installed here. POSTGRES_URL is the plain postgres://
// connection string the same integration provides, compatible with a
// standard PrismaClient. If provisioning Postgres elsewhere (Neon,
// Supabase, local), name the connection string env var POSTGRES_URL to
// match. See README for local setup.

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())

  // Access / billing state
  plan             String?   // "monthly" | "onetime" | null
  stripeCustomerId String?
  stripeSubId      String?
  accessUntil      DateTime? // for monthly subscribers: paid through this date
  hasLifetime      Boolean   @default(false) // true for one-off £50 payment

  progress       Progress[]
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  day         Int
  attempts    Int       @default(0)
  bestScore   Int       @default(0) // percentage 0-100
  passed      Boolean   @default(false)
  passedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}
