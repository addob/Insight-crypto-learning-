# --- Database ---
# Dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) example — see README for provider swap steps:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# Prefer a restricted key (rk_...) scoped to Checkout/Customers/
# Subscriptions/Billing Portal/Webhooks over the full account secret key
# (sk_...) — see README "Stripe (payments)" section. Use *_test_ values
# while building, switch to *_live_ only when ready to take real payments.
# Never commit a real key here — this file is a template only.
STRIPE_SECRET_KEY="rk_test_xxxxxxxxxxxx"
# Webhook must be subscribed to: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid,
# invoice.payment_failed, customer.subscription.updated,
# customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
# Price IDs from Stripe Dashboard > Product catalog (two separate Products —
# don't put both prices on one product)
STRIPE_PRICE_MONTHLY="price_xxx_monthly_5gbp"
STRIPE_PRICE_ONETIME="price_xxx_onetime_50gbp"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="clarity@insightcryptolearning.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="447957458795"
NEXT_PUBLIC_WHATSAPP_DISPLAY="07957 458795"
